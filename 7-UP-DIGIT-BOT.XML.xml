// Boom Indices Sell-Only Bot for Deriv
// Uses Ichimoku (Tenkan 200, Kijun 3, Senkou B 200) & ADX (7)
// Takes Profit after 4 Candles

// Bot Inputs
input int Lots = 1;            // Lot size
input int ADX_Period = 7;      // ADX period
input double Min_ADX = 20.0;   // Minimum ADX value for a strong trend

// Updated Ichimoku Settings
input int Tenkan = 200;
input int Kijun = 3;
input int SenkouB = 200;

// Trade Management
int tradeCounter = 0; // Track candles since entry

// Indicator Handles
int ichimokuHandle, adxHandle;

// Initialize
void OnInit()
{
    ichimokuHandle = iIchimoku(NULL, 0, Tenkan, Kijun, SenkouB);
    adxHandle = iADX(NULL, 0, ADX_Period);
}

// Main Trading Logic
void OnTick()
{
    double tenkan, kijun, spanB, adxValue;
    
    // Get Ichimoku values
    CopyBuffer(ichimokuHandle, 0, 0, 1, tenkan);
    CopyBuffer(ichimokuHandle, 1, 0, 1, kijun);
    CopyBuffer(ichimokuHandle, 4, 0, 1, spanB);
    
    // Get ADX value
    CopyBuffer(adxHandle, 0, 0, 1, adxValue);

    // Conditions for Sell Trade
    if (tenkan < kijun && tenkan < spanB && adxValue > Min_ADX && OrdersTotal() == 0)
    {
        // Open Sell Order
        tradeCounter = 0;
        TradeSell();
    }

    // Manage Open Trade (Close after 4 candles)
    if (OrdersTotal() > 0)
    {
        tradeCounter++;
        if (tradeCounter >= 4)
        {
            CloseAllTrades();
        }
    }
}

// Function to Open Sell Trade
void TradeSell()
{
    MqlTradeRequest request;
    MqlTradeResult result;
    
    request.action = TRADE_ACTION_DEAL;
    request.type = ORDER_TYPE_SELL;
    request.symbol = Symbol();
    request.volume = Lots;
    request.price = SymbolInfoDouble(Symbol(), SYMBOL_BID);
    request.deviation = 10;
    request.magic = 123456;
    request.comment = "Boom Sell Bot";
    
    OrderSend(request, result);
}

// Function to Close All Open Trades
void CloseAllTrades()
{
    for (int i = 0; i < OrdersTotal(); i++)
    {
        ulong ticket = OrderGetTicket(i);
        if (OrderSelect(ticket))
        {
            MqlTradeRequest closeRequest;
            MqlTradeResult closeResult;
            
            closeRequest.action = TRADE_ACTION_CLOSE_BY;
            closeRequest.position = ticket;
            
            OrderSend(closeRequest, closeResult);
        }
    }
}
